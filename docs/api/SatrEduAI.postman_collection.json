{
  "info": {
    "name": "Satr Edu AI — Full API",
    "description": "Complete Postman collection for Satr Edu AI platform.\nBase URL: http://localhost\n\nFlow:\n1. Register Operations user\n2. Login → token saved automatically\n3. Register Teacher → approve\n4. Create Project\n5. Upload + Process file\n6. NLP Index\n7. Chat / Exam",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "var token = pm.collectionVariables.get('token');",
          "if (!token || token.length < 10) {",
          "    console.log('⚠️ No token — run Login first');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": " System",
      "item": [
        {
          "name": "Welcome",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/"
          }
        },
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health"
          }
        },
        {
          "name": "Swagger Docs",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/docs"
          }
        }
      ]
    },
    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "1. Register Operations (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_name\": \"Admin User\",\n  \"user_email\": \"admin@satr.com\",\n  \"user_password\": \"Admin1234!\",\n  \"user_role\": \"operations\"\n}"
            }
          }
        },
        {
          "name": "2. Register Teacher",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_name\": \"Ahmed Teacher\",\n  \"user_email\": \"teacher@satr.com\",\n  \"user_password\": \"Teacher1234!\",\n  \"user_role\": \"teacher\"\n}"
            }
          }
        },
        {
          "name": "3. Register Student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_name\": \"Mohamed Student\",\n  \"user_email\": \"student@satr.com\",\n  \"user_password\": \"Student1234!\",\n  \"user_role\": \"student\"\n}"
            }
          }
        },
        {
          "name": "4. Login → saves token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.access_token) {",
                  "    pm.collectionVariables.set('token', json.access_token);",
                  "    console.log('✅ Token saved');",
                  "} else {",
                  "    console.log('❌ Login failed:', JSON.stringify(json));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_email\": \"admin@satr.com\",\n  \"user_password\": \"Admin1234!\"\n}"
            }
          }
        },
        {
          "name": "5. Who Am I",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/me"
          }
        },
        {
          "name": "6. Approve Teacher",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/teacher/approve/{{teacher_id}}"
          }
        },
        {
          "name": "7. Pending Teachers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/teacher/pending"
          }
        }
      ]
    },
    {
      "name": "📁 Projects (KB Management)",
      "item": [
        {
          "name": "1. Create Project",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.project && json.project.project_id) {",
                  "    pm.collectionVariables.set('project_id', json.project.project_id);",
                  "    console.log('✅ project_id saved:', json.project.project_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/projects",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"project_name\": \"ميكانيكا الكم\",\n  \"project_description\": \"مادة ميكانيكا الكم للفرقة الثالثة\"\n}"
            }
          }
        },
        {
          "name": "2. List All Projects",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/projects?page=1&page_size=10",
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "3. Get Project Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/projects/{{project_id}}"
          }
        },
        {
          "name": "4. Project Stats (files + chunks + vectors)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/projects/{{project_id}}/stats"
          }
        },
        {
          "name": "5. Update Project Settings",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/projects/{{project_id}}/settings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"chunk_size\": 800,\n  \"chunk_overlap\": 80,\n  \"use_deepdoc\": true,\n  \"language\": \"ar\"\n}"
            }
          }
        },
        {
          "name": "6. Delete Project",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/projects/{{project_id}}"
          }
        }
      ]
    },
    {
      "name": "📤 Data (Upload & Process)",
      "item": [
        {
          "name": "1. Upload File",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.file_id) {",
                  "    pm.collectionVariables.set('file_id', json.file_id);",
                  "    console.log('✅ file_id saved:', json.file_id);",
                  "} else if (json.data && json.data.file_id) {",
                  "    pm.collectionVariables.set('file_id', json.data.file_id);",
                  "    console.log('✅ file_id saved:', json.data.file_id);",
                  "} else {",
                  "    console.log('Response:', JSON.stringify(json));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/upload/{{project_id}}",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                }
              ]
            }
          }
        },
        {
          "name": "2. Process File (DeepDoc Smart Chunking)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/process/{{project_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"file_id\": \"{{file_id}}\",\n  \"chunk_size\": 800,\n  \"chunk_overlap\": 80,\n  \"do_reset\": false,\n  \"use_deepdoc\": true\n}"
            }
          }
        },
        {
          "name": "3. Process File (Simple — Non-PDF)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/process/{{project_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"file_id\": \"{{file_id}}\",\n  \"chunk_size\": 1000,\n  \"chunk_overlap\": 100,\n  \"do_reset\": false,\n  \"use_deepdoc\": false\n}"
            }
          }
        },
        {
          "name": "4. List Files",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/files/{{project_id}}"
          }
        },
        {
          "name": "5. List Chunks",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/chunks/{{project_id}}?page=1&page_size=5",
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "5"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "🔍 NLP (RAG Pipeline)",
      "item": [
        {
          "name": "1. Index to Vector DB (Push)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/nlp/index/push/{{project_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"do_reset\": 1\n}"
            }
          }
        },
        {
          "name": "2. Vector DB Info",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/nlp/index/info/{{project_id}}"
          }
        },
        {
          "name": "3. Search (Hybrid — Vector + Keyword)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/nlp/search/{{project_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"ما هو مبدأ عدم اليقين؟\",\n  \"limit\": 5\n}"
            }
          }
        },
        {
          "name": "4. RAG Answer (Single Question)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/nlp/answer/{{project_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"اشرح مفهوم التشابك الكمي\",\n  \"limit\": 5\n}"
            }
          }
        }
      ]
    },
    {
      "name": "💬 Chat (Multi-turn RAG)",
