              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/chat/{{project_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"وضّح لي أكثر عن النقطة الأولى\",\n  \"conversation_id\": \"{{conversation_id}}\",\n  \"limit\": 5\n}"
            }
          }
        },
        {
          "name": "3. Another Follow-up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/chat/{{project_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"أعطني مثالاً تطبيقياً\",\n  \"conversation_id\": \"{{conversation_id}}\",\n  \"limit\": 5\n}"
            }
          }
        },
        {
          "name": "4. List My Conversations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/chat/conversations?project_id={{project_id}}",
              "query": [
                {
                  "key": "project_id",
                  "value": "{{project_id}}"
                }
              ]
            }
          }
        },
        {
          "name": "5. Get Conversation Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/chat/conversations/{{conversation_id}}"
          }
        },
        {
          "name": "6. Clear Conversation History",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/chat/conversations/{{conversation_id}}/clear"
          }
        },
        {
          "name": "7. Delete Conversation",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/chat/conversations/{{conversation_id}}"
          }
        }
      ]
    },
