    {
      "name": "📝 Exams",
      "item": [
        {
          "name": "1. Create Exam",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.exam_id) {",
                  "    pm.collectionVariables.set('exam_id', json.exam_id);",
                  "    console.log('✅ exam_id saved:', json.exam_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/exam/create",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"project_id\": \"{{project_id}}\",\n  \"exam_title\": \"امتحان منتصف الترم\",\n  \"num_questions\": 5,\n  \"difficulty\": \"medium\",\n  \"question_types\": [\"MCQ\", \"True/False\"]\n}"
            }
          }
        },
        {
          "name": "2. Get Exam Info",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/exam/{{exam_id}}"
          }
        },
        {
          "name": "3. Approve Exam (Teacher)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/exam/{{exam_id}}/approve"
          }
        },
        {
          "name": "4. Student — Available Exams",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/exam/student/project/{{project_id}}"
          }
        },
        {
          "name": "5. Submit Answers",
          "request": {
            "method": "POST",
