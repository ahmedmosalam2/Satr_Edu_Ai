OPENAI_API_KEY=""
OPENAI_API_URL="https://api.openai.com/v1"

FILE_ALLOWED_EXTION=[".pdf",".doc",".docx",".txt"]
IMAGE_ALLOWED_EXTION=[".jpg",".jpeg",".png"]
FILE_MAX_SIZE=10
FILE_DEFALUTE_CHUNK=512000

# ========================= LLM Config =========================
GENERATION_BACKEND="OLLAMA"
EMBEDDING_BACKEND="OLLAMA"

GENERATION_MODEL_ID="llama3.2:latest"
EMBEDDING_MODEL_ID="nomic-embed-text:latest"
EMBEDDING_MODEL_SIZE=768

# Ollama Host (Stable Docker-to-Host alias)
OLLAMA_BASE_URL="http://host.docker.internal:11434"

INPUT_DAFAULT_MAX_CHARACTERS=1024
GENERATION_DAFAULT_MAX_TOKENS=200
GENERATION_DAFAULT_TEMPERATURE=0.1

# ========================= Vector DB Config =========================
VECTOR_DB_BACKEND="QDRANT"
VECTOR_DB_PATH="http://localhost:6333"
VECTOR_DB_DISTANCE_METHOD="cosine"

# ========================= Auth / JWT =========================
JWT_SECRET_KEY="satr-edu-super-secret-key-change-in-production-2026"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES=1440

# ========================= MongoDB =========================
MONGODB_URL=mongodb://admin:admin@localhost:27017
MONGODB_DATABASE=Satr-Edu

# ========================= Reranker Config =========================
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=3

# ========================= Redis / Celery =========================
REDIS_URL=redis://localhost:6379/0

# ========================= OCR / Gemini Vision =========================
# OCR Backend: gemini (recommended) | local (GPU) | tesseract (CPU)
OCR_BACKEND=gemini
GEMINI_API_KEY=AIzaSyCVl7O7OIvDFODfVCMmqMj_7SXfzxe6H88
GEMINI_VISION_MODEL=gemini-2.0-flash
